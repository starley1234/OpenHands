# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts and other files that must keep LF line endings regardless of
# the platform. Without these, git on Windows (core.autocrlf=true) converts
# them to CRLF on checkout, which breaks the `#!/usr/bin/env bash` shebang
# ("env: 'bash\r': No such file or directory") and breaks the Docker image
# build/startup.
*.sh text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
Dockerfile text eol=lf
*.dockerfile text eol=lf
.env.example text eol=lf
