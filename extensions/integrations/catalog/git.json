{
  "id": "git",
  "name": "Git",
  "description": "Операции с локальным git-репозиторием: log, diff, blame, status и другое.",
  "docsUrl": "https://github.com/modelcontextprotocol/servers/tree/main/src/git",
  "iconBg": "#F1502F",
  "keywords": [
    "version control",
    "log",
    "diff",
    "blame"
  ],
  "installHint": "Runs the official Python server via uvx — no setup beyond the path.",
  "connectionOptions": [
    {
      "id": "api",
      "provider": "mcp",
      "transport": {
        "kind": "stdio",
        "serverName": "git",
        "command": "uvx",
        "args": [
          "mcp-server-git",
          "--repository"
        ],
        "argFields": [
          {
            "key": "repo_path",
            "label": "Repository path",
            "type": "text",
            "placeholder": "/Users/me/code/my-repo",
            "required": true,
            "helperText": "Appended as --repository <path>."
          }
        ]
      },
      "auth": {
        "strategy": "api_key"
      }
    }
  ]
}
